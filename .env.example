DATABASE_URL=postgresql+psycopg://forgeops:forgeops@localhost:5432/forgeops
FORGEOPS_AGENT_MODEL=gpt-5-mini
FORGEOPS_AGENT_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Must match the region that issued the keys above: https://cloud.langfuse.com
# for EU, https://us.cloud.langfuse.com for US. A mismatch is rejected with 401.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LOG_LEVEL=INFO
